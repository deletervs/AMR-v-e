<?xml version="1.0"?>
<!-- 只读电压与里程计采集：不加载底盘/云台控制器；厂商握手仍会写系统信息，需现场运行授权。 -->
<launch>
    <arg name="robolink_config_file" doc="本项目 robolink_odometry.txt 的绝对路径"/>
    <arg name="serial_port" default="/dev/HFRobot"/>
    <node name="rs_telemetry_hw" pkg="handsfree_hw" type="handsfree_hw_node"
          output="screen" respawn="false" required="true">
        <param name="serial_port" value="$(arg serial_port)"/>
        <param name="robolink_config_file" value="$(arg robolink_config_file)"/>
        <param name="rs_publish_odometry" type="bool" value="true"/>
        <param name="with_chassis" type="bool" value="true"/>
        <param name="chassis_type" value="gemini"/>
        <param name="with_lift" type="bool" value="false"/>
        <param name="with_arm" type="bool" value="false"/>
        <param name="with_head" type="bool" value="false"/>
    </node>
</launch>
